# MongoDB connection string. GridFS (file storage) and every collection
# live in this same database — see README's "Why GridFS?" section.
MONGODB_URI=mongodb://localhost:27017/file-vault

# Random string used to sign the login session cookie (HMAC). Generate one
# with: openssl rand -hex 32
# Changing this logs everyone out, since existing cookies stop verifying.
AUTH_SECRET=change-me-to-a-random-64-char-hex-string

# --- Upload limits (all optional — sensible defaults apply if unset) ---
# Deliberately NOT prefixed with NEXT_PUBLIC_: these are read server-side
# only, so changing them just needs an env edit + restart, not a rebuild.
# The client learns the current value at runtime from GET /api/config.

# Max size of a single uploaded file, in bytes. Default: 26214400 (25MB).
# MAX_FILE_SIZE_BYTES=26214400

# Max size a file can be to open/edit in the Excel editor, in bytes.
# Parsing and rewriting a spreadsheet in memory costs more than just
# storing its bytes, so this can be capped separately from the general
# upload limit above. Defaults to the same value as MAX_FILE_SIZE_BYTES
# if unset.
# MAX_EXCEL_FILE_SIZE_BYTES=10485760

# Max number of files accepted in a single upload request. Default: 20.
# MAX_FILES_PER_UPLOAD=20
